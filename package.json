{
  "name": "composelint",
  "version": "0.2.0",
  "description": "Linter and formatter for Docker Compose files, with key ordering, style, and security checks",
  "keywords": [
    "docker",
    "compose",
    "lint",
    "linter",
    "yaml",
    "formatter"
  ],
  "homepage": "https://github.com/nbsp1221/composelint#readme",
  "bugs": {
    "url": "https://github.com/nbsp1221/composelint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbsp1221/composelint.git"
  },
  "license": "MIT",
  "author": "nbsp1221",
  "type": "module",
  "bin": {
    "composelint": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --exclude 'tests/**/*.e2e.test.ts'",
    "test:watch": "vitest --exclude 'tests/**/*.e2e.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "schema:update": "node scripts/update-compose-schema.mjs",
    "test:e2e": "vitest run tests/cli.e2e.test.ts",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "citty": "^0.2.2",
    "cosmiconfig": "^9.0.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.1.2",
    "@types/picomatch": "4.0.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
